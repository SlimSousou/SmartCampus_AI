@startuml
skinparam defaultFontSize 14
skinparam defaultFontColor #333333
skinparam {
    ranksep 80
    nodesep 70
}
skinparam linetype ortho
hide circle

title Modele relationnel IIT/ISB - Candidatures et referentiels

entity "users" as users {
  * id : uuid <<PK>>
  --
  * email : varchar <<UK>>
  * role : varchar
  * is_active : boolean
}

entity "candidate_profiles" as candidate_profiles {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK,UK>>
  current_education : varchar
  graduation_year : int
  target_institution : varchar
}

entity "programs" as programs {
  * id : uuid <<PK>>
  --
  * institution : varchar
  * name : varchar
  * level : varchar
  * is_published : boolean
  * is_demo : boolean
}

entity "candidate_applications" as candidate_applications {
  * id : uuid <<PK>>
  --
  * candidate_user_id : uuid <<FK>>
  * program_id : uuid <<FK>>
  * academic_year : varchar
  * status : varchar
  * version : int
}

entity "recommendations" as recommendations {
  * id : uuid <<PK>>
  --
  * application_id : uuid <<FK>>
  * program_id : uuid <<FK>>
  score : decimal
  * status : varchar
  reviewed_by_user_id : uuid <<FK>>
}

entity "document_sources" as document_sources {
  * id : uuid <<PK>>
  --
  institution : varchar
  * title : varchar
  * storage_key : varchar
  * checksum_sha256 : varchar
  * version : int
  * status : varchar
  uploaded_by_user_id : uuid <<FK>>
}

entity "document_chunks" as document_chunks {
  * id : uuid <<PK>>
  --
  * document_source_id : uuid <<FK>>
  * chunk_index : int
  * content : text
  metadata_json : json
}

entity "document_sync_runs" as document_sync_runs {
  * id : uuid <<PK>>
  --
  * document_source_id : uuid <<FK>>
  * idempotency_key : varchar <<UK>>
  * status : varchar
  * processed_count : int
}

entity "refresh_sessions" as refresh_sessions {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
}

entity "audit_events" as audit_events {
  * id : uuid <<PK>>
  --
  * actor_user_id : uuid <<FK>>
  * subject_user_id : uuid <<FK>>
}

users ||--o| candidate_profiles : "possede"
users ||--o{ candidate_applications : "depose"
programs ||--o{ candidate_applications : "concerne"
candidate_applications ||--o{ recommendations : "recoit"
programs ||--o{ recommendations : "propose"
users |o--o{ recommendations : "valide"
users |o--o{ document_sources : "depose"
document_sources ||--o{ document_chunks : "contient"
document_sources ||--o{ document_sync_runs : "synchronise"
users ||--o{ refresh_sessions : "authentifie"
users ||--o{ audit_events : "acteur"
users ||--o{ audit_events : "sujet"

@enduml
